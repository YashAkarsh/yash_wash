<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/cardview_background_whit_not_projection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/no_button_img">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/text_color_defult"
                android:gravity="center"
                android:id="@+id/font_button_title_id"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:text="Warm prompt"/>
            <View
                android:background="#ffeeeeee"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="13sp"
                android:textColor="@color/app_black_6"
                android:gravity="left"
                android:id="@+id/font_button_text_id"
                android:paddingTop="15dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:maxHeight="300dp"
                android:text="@string/policy_first_alert_msg"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp">
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="13sp"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:gravity="center"
                    android:id="@+id/font_button_id_no"
                    android:background="@drawable/background_blue_bian_button_7"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/policy_first_alert_no"
                    android:layout_weight="1"/>
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="13sp"
                    android:textColor="@color/app_white"
                    android:gravity="center"
                    android:id="@+id/font_button_id_yes"
                    android:background="@drawable/background_blue_button_7"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/policy_first_alert_yes"
                    android:layout_weight="1"
                    android:layout_marginStart="40dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
