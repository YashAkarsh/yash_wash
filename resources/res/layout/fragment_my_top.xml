<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lly_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_setting"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_setting_white"
            android:layout_marginEnd="15dp"/>
        <ImageView
            android:id="@+id/iv_message"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_message_white"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_face_fragment_my"
        android:background="@drawable/face_whit_background"
        android:padding="3dp"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/icon_touxiang_wode"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="18sp"
        android:textColor="@color/my_whit"
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13sp"
        android:textColor="@color/my_whit"
        android:gravity="center"
        android:id="@+id/tv_profile"
        android:background="@drawable/my_fragment_profile_edit"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_marginTop="14dp"
        android:text="@string/my_page_titlebtn"/>
</LinearLayout>
