<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="13sp"
                android:textColor="@color/app_text"
                android:id="@+id/tv_title_coupon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="30dp"
                android:text="@string/barrels_of_clean_select"/>
            <com.haier.globalwasher.view.custom_view.mlistview.MaxHeightListView
                android:id="@+id/lv_preferential_approach"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:listSelector="@android:color/transparent"
                android:divider="@null"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="13sp"
                android:textColor="@color/app_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="22dp"
                android:text="@string/barrels_of_clean_payments"/>
            <com.haier.globalwasher.view.custom_view.mlistview.MaxHeightListView
                android:id="@+id/lv_payList"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:listSelector="@android:color/transparent"
                android:divider="@null"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="14sp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:id="@+id/tv_clean_bucket_countdown"
        android:background="@color/app_zhexian_blue_relg"
        android:layout_width="match_parent"
        android:layout_height="25dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@color/app_white"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="16sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:gravity="center"
            android:id="@+id/tv_clean"
            android:background="@drawable/button_background_g40_stroke"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginRight="12dp"
            android:text="@string/barrels_of_clean_onebtn"
            android:layout_weight="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="16sp"
            android:textColor="@color/app_white"
            android:gravity="center"
            android:id="@+id/tv_pay"
            android:background="@drawable/button_background_g40_blue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:text="@string/barrels_of_clean_twobtn"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
