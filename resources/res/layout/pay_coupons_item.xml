<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="@dimen/defult_padding_16"
    android:paddingRight="14dp"
    android:paddingBottom="@dimen/defult_padding_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/defult_padding_16"
    android:layout_marginRight="@dimen/defult_padding_16">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_youhuiquan"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="17sp"
        android:textColor="@color/app_black_6"
        android:id="@+id/tv_coupon_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/app_text"
        android:id="@+id/tv_endTime"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"/>
    <CheckBox
        android:id="@+id/cb_selelct_pay"
        android:background="@drawable/select_pay_background"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@null"/>
</LinearLayout>
