<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/sp_viewpager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="30dp">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/font_id_text"
            android:background="@drawable/background_blue_and_whit"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="20sp"
            android:textColor="@color/app_text_coler"
            android:gravity="center"
            android:id="@+id/font_id_text_tow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/font_id_text"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:textColor="@color/app_white"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="129dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/sp_dot"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/app_white"
            android:gravity="center"
            android:id="@+id/sp_btn_logn"
            android:background="@drawable/background_blue_button"
            android:paddingLeft="30dp"
            android:paddingTop="10dp"
            android:paddingRight="30dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="265dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:text="@string/introduction_btn"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
