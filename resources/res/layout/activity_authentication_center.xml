<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.haier.globalwasher.view.custom_view.xlist.XListView
        android:id="@+id/xlv_page"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:divider="@null"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="16dp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_submit"
        android:background="@drawable/background_huise_button"
        android:layout_width="265dp"
        android:layout_height="50dp"
        android:layout_marginTop="41dp"
        android:text="@string/authentication_center_btn_title"
        android:translationZ="3dp"
        android:elevation="3dp"
        android:outlineProvider="background"/>
</LinearLayout>
