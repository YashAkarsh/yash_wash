<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/laundry_lin"
    android:background="@drawable/details_laundry_item_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/cardview_background_left5"
        android:paddingLeft="12dp"
        android:paddingTop="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/app_black_6"
            android:id="@+id/details_laundry_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text=""/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/details_laundry_name">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/app_zhexian_blue_relg"
                android:gravity="center_vertical"
                android:id="@+id/details_laundry_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text=""
                android:drawableLeft="@drawable/icon_zhuangtai_blue_xiyidianxiangqing"
                android:drawablePadding="5dp"/>
            <View
                android:id="@+id/details_laundry_line"
                android:background="@color/division_line"
                android:visibility="gone"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/app_text"
                android:gravity="center_vertical"
                android:id="@+id/details_laundry_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:drawableLeft="@drawable/icon_dengdai_red_xiyidianxiangqing"
                android:drawablePadding="5dp"/>
        </LinearLayout>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_text"
            android:id="@+id/details_laundry_floor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:text=""
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
