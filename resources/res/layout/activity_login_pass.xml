<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/lingin_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="66dp"
                android:text="@string/account_userlogin_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="47dp"
                android:layout_marginTop="57dp"
                android:layout_marginRight="47dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_userlogin_phone"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/lingin_text_color"
                        android:gravity="center"
                        android:id="@+id/et_phone_prefix"
                        android:background="@drawable/overall_situation_edit_unselected"
                        android:paddingRight="5dp"
                        android:layout_width="65dp"
                        android:layout_height="54dp"
                        android:layout_marginRight="10dp"
                        android:drawableRight="@drawable/icon_xialasanjiao_denglu"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <EditText
                            android:textSize="19sp"
                            android:textColor="@color/lingin_text_color"
                            android:gravity="center_vertical"
                            android:id="@+id/et_phone"
                            android:background="@drawable/overall_situation_edit_unselected"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:cursorVisible="true"
                            android:maxLength="15"
                            android:layout_centerVertical="true"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/et_phone_pass"
                            android:textCursorDrawable="@drawable/overall_situation_edit"/>
                        <ImageButton
                            android:id="@+id/login_phone_dele"
                            android:background="@drawable/icon_cha_denglu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/lingin_text_erre"
                    android:id="@+id/phone_erre"
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text=""/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_userlogin_pwd"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <EditText
                        android:textSize="19sp"
                        android:textColor="@color/lingin_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/et_phone_pass"
                        android:background="@drawable/overall_situation_edit_unselected"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:cursorVisible="true"
                        android:layout_centerVertical="true"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@drawable/overall_situation_edit"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true">
                        <ImageButton
                            android:id="@+id/login_password_eye"
                            android:background="@drawable/select_see_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="15dp"/>
                        <ImageButton
                            android:id="@+id/login_password_dele"
                            android:background="@drawable/icon_cha_denglu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </RelativeLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/lingin_text_erre"
                    android:id="@+id/phone_pass_erre"
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text=""/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/app_white"
                android:gravity="center"
                android:id="@+id/bt_login"
                android:background="@drawable/background_huise_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="60dp"
                android:text="@string/account_userlogin_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/lingin_text_color"
                android:gravity="center"
                android:id="@+id/login_forgot_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/account_userlogin_forgot"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/lingin_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_userlogin_account"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:id="@+id/register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/account_userlogin_singup"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
