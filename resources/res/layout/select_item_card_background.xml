<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:textSize="15sp"
            android:textColor="@color/app_black_6"
            android:gravity="center"
            android:id="@+id/tv_select_item"
            android:background="@drawable/first_laundry_item_select"
            android:layout_width="86dp"
            android:layout_height="45dp"
            android:layout_marginLeft="@dimen/defult_padding_16"
            android:layout_marginTop="@dimen/projection_list_top"
            android:layout_marginRight="@dimen/defult_padding_16"
            android:layout_marginBottom="@dimen/projection_list_bottom"
            android:src="@color/app_black_6"
            android:translationZ="3dp"
            android:elevation="10dp"/>
    </LinearLayout>
</LinearLayout>
