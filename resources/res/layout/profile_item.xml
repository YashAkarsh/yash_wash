<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/lly_background"
    android:paddingLeft="15dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="17sp"
        android:textColor="@color/app_black_6"
        android:gravity="center"
        android:id="@+id/tv_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="1px"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/iv_face"
        android:background="@drawable/face_background"
        android:padding="2dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/icon_touxiang_wode"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="15sp"
        android:textColor="@color/app_black_6"
        android:id="@+id/tv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_arrow_wode"/>
</LinearLayout>
