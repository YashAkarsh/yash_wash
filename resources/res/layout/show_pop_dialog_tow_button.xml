<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/cardview_background_whit_not_projection"
        android:padding="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/no_button_img">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/app_zhexian_blue_relg"
                android:gravity="center"
                android:id="@+id/font_button_title_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:text=""/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="13sp"
                android:textColor="@color/app_black_6"
                android:gravity="center"
                android:id="@+id/font_button_text_id"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:text=""/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="13sp"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:gravity="center"
                    android:id="@+id/font_button_id_no"
                    android:background="@drawable/background_blue_bian_button_7"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:text=""
                    android:layout_weight="1"/>
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="13sp"
                    android:textColor="@color/app_white"
                    android:gravity="center"
                    android:id="@+id/font_button_id_yes"
                    android:background="@drawable/background_blue_button_7"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
