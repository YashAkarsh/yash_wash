<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lly_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/lly_select_model"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="@dimen/defult_padding_16"
        android:layout_marginTop="@dimen/projection_list_top"
        android:layout_marginRight="@dimen/defult_padding_16"
        android:layout_marginBottom="@dimen/projection_list_bottom"
        android:translationZ="2dp"
        android:elevation="3dp"
        android:outlineProvider="background">
        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="13dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_black_6"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:maxEms="6"
            android:singleLine="true"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_text"
            android:id="@+id/tv_time_mins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12.5dp"/>
    </LinearLayout>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/device_run_model_item_subsidiary_content_text"
        android:orientation="vertical"
        android:id="@+id/tv_introduce"
        android:background="@drawable/item_subsidiary_entry"
        android:paddingLeft="16dp"
        android:paddingTop="13dp"
        android:paddingRight="20dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/defult_padding_16"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="@dimen/defult_padding_16"
        android:layout_marginBottom="12dp"
        android:drawableLeft="@drawable/icon_shuoming"
        android:drawablePadding="5dp"/>
</LinearLayout>
