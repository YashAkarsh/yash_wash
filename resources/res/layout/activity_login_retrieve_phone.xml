<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/lingin_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:text="@string/find_pwd_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="47dp"
            android:layout_marginTop="57dp"
            android:layout_marginRight="47dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:id="@+id/tv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/find_pwd_user_phone"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_ret_gre"
                    android:id="@+id/tv_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/find_pwd_user_email"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lly_phone"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <TextView
                    android:textSize="19sp"
                    android:textColor="@color/lingin_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/et_phone_prefix"
                    android:background="@drawable/overall_situation_edit_unselected"
                    android:paddingRight="5dp"
                    android:layout_width="65dp"
                    android:layout_height="54dp"
                    android:layout_marginRight="10dp"
                    android:drawableRight="@drawable/icon_xialasanjiao_denglu"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <EditText
                        android:textSize="19sp"
                        android:textColor="@color/lingin_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/et_phone"
                        android:background="@drawable/overall_situation_edit_unselected"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:cursorVisible="true"
                        android:layout_centerVertical="true"
                        android:inputType="number"
                        android:textCursorDrawable="@drawable/overall_situation_edit"/>
                    <ImageButton
                        android:id="@+id/login_phone_dele"
                        android:background="@drawable/icon_cha_denglu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rly_email"
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <EditText
                    android:textSize="19sp"
                    android:textColor="@color/lingin_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/et_email"
                    android:background="@drawable/overall_situation_edit_unselected"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:cursorVisible="true"
                    android:layout_centerVertical="true"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/overall_situation_edit"/>
                <ImageButton
                    android:id="@+id/email_dele"
                    android:background="@drawable/icon_cha_denglu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/lingin_text_erre"
                android:id="@+id/phone_erre"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:id="@+id/bt_login"
        android:background="@drawable/background_huise_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="100dp"
        android:text="@string/find_pwd_btn"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
