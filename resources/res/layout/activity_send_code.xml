<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lly_edit_code"
    android:background="@color/app_white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/app_zhexian_blue_relg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="47dp"
        android:layout_marginTop="74dp"
        android:text="@string/verify_the_machine_bigtitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="47dp"
        android:paddingRight="47dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="8dp">
        <EditText
            android:textSize="20sp"
            android:textColor="@color/verify_machine"
            android:gravity="center_vertical"
            android:id="@+id/et_code"
            android:background="@null"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:cursorVisible="false"
            android:maxLength="4"
            android:layout_weight="1"
            android:inputType="number"
            android:letterSpacing="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="16sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:gravity="center"
            android:id="@+id/tv_send_code"
            android:background="@drawable/button_background_g40_stroke"
            android:layout_width="75dp"
            android:layout_height="40dp"
            android:text="@string/verify_the_machine_resed"
            android:layout_alignParentRight="true"/>
    </LinearLayout>
    <View
        android:background="@color/line_edit_bottom"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginLeft="47dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="47dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/error_text"
        android:id="@+id/tv_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="47dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="47dp"
        android:text="@string/verify_the_machine_error"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:src="@drawable/pic_yanzhengjiqi"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/verify_machine"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/verify_the_machine_details"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="16sp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_confirmed"
        android:background="@drawable/background_blue_button"
        android:layout_width="265dp"
        android:layout_height="50dp"
        android:layout_marginTop="50dp"
        android:text="@string/verify_the_machine_btn"/>
</LinearLayout>
