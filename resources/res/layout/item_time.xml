<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/app_white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/app_black_6"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:text="@string/selective_drying_mode_dryingtime"
        android:layout_toRightOf="@+id/smart_recommend"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/smart_recommend"
        android:background="@drawable/dry_time_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginBottom="5dp"
        android:layout_alignTop="@+id/tv_desc"
        android:layout_centerVertical="true"/>
</RelativeLayout>
