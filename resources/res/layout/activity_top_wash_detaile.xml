<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="25dp"
    android:paddingRight="25dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/app_white"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="15sp"
            android:textColor="@color/app_white"
            android:id="@+id/tv_stuta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/icon_ganyiji"
            android:drawablePadding="5dp"/>
        <View
            android:background="@color/device_top_line"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_white"
            android:id="@+id/tv_floor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/device_top_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="14sp"
        android:textColor="@color/app_white"
        android:id="@+id/tv_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/icon_dizhi_bai"
        android:drawablePadding="5dp"/>
</LinearLayout>
