<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="150dp"
        android:layout_height="match_parent">
        <Button
            android:textSize="14sp"
            android:textColor="@color/app_black"
            android:id="@+id/bt_search"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="搜索蓝牙"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/app_black"
            android:id="@+id/bt_stop_connect"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="断开连接"/>
        <Button
            android:id="@+id/bt_delete_log"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="清空日志"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:id="@+id/bt_first_page_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="组合命令（首页数据）"/>
                <Button
                    android:id="@+id/bt_get_all_steps"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="计步总数据-首页"/>
                <Button
                    android:id="@+id/bt_get_position_steps"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="获得步数详细数据"/>
                <Button
                    android:id="@+id/bt_set_target"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置目标数据"/>
                <Button
                    android:id="@+id/bt_get_target"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="获取目标数据"/>
                <Button
                    android:id="@+id/bt_get_sleep_detail_info"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="睡眠记录-首页"/>
                <Button
                    android:id="@+id/bt_get_sleep_info_debug"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="睡眠调试数据"/>
                <Button
                    android:id="@+id/bt_get_hr_data"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="心率-首页"/>
                <Button
                    android:id="@+id/bt_get_bo_data"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="血氧-首页"/>
                <Button
                    android:id="@+id/bt_get_temperatrue"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="温度-首页"/>
                <Button
                    android:id="@+id/bt_switch_motion"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="运动模式控制开关"/>
                <Button
                    android:id="@+id/bt_setTime"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置时间"/>
                <Button
                    android:id="@+id/bt_getTime"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="获取时间"/>
                <Button
                    android:id="@+id/bt_setUserInfo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置用户信息"/>
                <Button
                    android:id="@+id/bt_getUserInfo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="获取用户信息"/>
                <Button
                    android:id="@+id/bt_setdevice_info"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置手环基本参数"/>
                <Button
                    android:id="@+id/bt_getdevice_info"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="获取手环基本参数"/>
                <Button
                    android:id="@+id/bt_setdevice_ID"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置设备Id"/>
                <Button
                    android:id="@+id/bt_setmodel_walk"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置记步模式"/>
                <Button
                    android:id="@+id/bt_read_device_electricity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设备电量"/>
                <Button
                    android:id="@+id/bt_read_device_mac"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设备MAC 地址"/>
                <Button
                    android:id="@+id/bt_getdevice_os_version"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设备OS版本号"/>
                <Button
                    android:id="@+id/bt_reset_device"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="恢复出厂设置"/>
                <Button
                    android:id="@+id/bt_set_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置蓝牙设备名称"/>
                <Button
                    android:id="@+id/bt_set_hr_temp_hrv"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置自动检测心率，温度 HRV时段："/>
                <Button
                    android:id="@+id/bt_get_hr_temp_hrv"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置自动检测心率，温度 HRV时段："/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/et_device_info"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:hint="写入命令"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/bt_send_command"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:text="发送"/>
        </LinearLayout>
        <ListView
            android:id="@+id/lv_device_list"
            android:layout_width="match_parent"
            android:layout_height="300dp"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
