<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_washer_lin"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="70dp">
        <com.haier.globalwasher.view.custom_view.wave_imageview.WaveFunctionView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_washer_time"
            android:background="@drawable/order_run_time_background"
            android:layout_width="150dp"
            android:layout_height="150dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/washering_title"
            android:gravity="center"
            android:id="@+id/tv_iv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/payment_success_pageds_middle"
            android:layout_centerHorizontal="true"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_white"
            android:gravity="center"
            android:id="@+id/tv_down_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="30dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_wahser_image"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="70dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="15sp"
        android:textColor="@color/first_page_bottom_text_true"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/payment_success_pageds_detail"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="16sp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_to_use_others"
        android:background="@drawable/background_blue_button"
        android:layout_width="265dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="@string/payment_success_pageds_nonebtn"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="16sp"
        android:textColor="@color/app_zhexian_blue_relg"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_order_details"
        android:background="@drawable/button_background_g40_stroke"
        android:layout_width="265dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="@string/payment_success_pageds_tenbtn"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="13dp"
            android:textColor="@color/app_black_6"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_end_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_list_Btn_End_order"
            android:layout_weight="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="13dp"
            android:textColor="@color/app_black_6"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_list_Btn_Restart"
            android:layout_weight="1"
            android:layout_alignParentRight="true"/>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13dp"
        android:textColor="@color/app_black_6"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13dp"
        android:textColor="@color/app_text"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/payment_success_pageds_time_View_help"/>
</LinearLayout>
