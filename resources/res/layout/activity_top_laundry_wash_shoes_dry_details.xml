<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/laundry_id"
    android:paddingLeft="25dp"
    android:paddingRight="25dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/app_black_6"
                android:id="@+id/laundry_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/laundry_name">
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="14sp"
                    android:textColor="@color/app_white"
                    android:gravity="center"
                    android:id="@+id/laundry_open"
                    android:background="@drawable/background_blue_button"
                    android:paddingLeft="15dp"
                    android:paddingTop="2dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Nearby_laundry_atlas_btn_open"/>
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="15sp"
                    android:textColor="@color/app_zhexian_blue_relg"
                    android:gravity="center_vertical"
                    android:id="@+id/laundry_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"/>
                <View
                    android:id="@+id/laundry_line"
                    android:background="@color/division_line"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"/>
                <com.haier.globalwasher.view.custom_view.FontTextView
                    android:textSize="14sp"
                    android:textColor="@color/app_text"
                    android:gravity="center_vertical"
                    android:id="@+id/laundry_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/laundry_img"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_xiyidiantupian"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rly_detail_activity_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <View
            android:background="@color/division_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <com.haier.globalwasher.view.custom_view.mlistview.MaxHeightListView
            android:id="@+id/lv_activitys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:listSelector="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8.5dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_white"
            android:ellipsize="end"
            android:id="@+id/ftv_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.6dp"
            android:lines="1"
            android:drawablePadding="6.5dp"
            android:layout_below="@+id/lv_activitys"
            android:drawableStart="@drawable/tishi"
            android:drawableEnd="@drawable/icon_arrow_down_white"/>
    </RelativeLayout>
</LinearLayout>
