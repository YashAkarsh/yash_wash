<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cardview_background_whit_not_projection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="15sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/ftv_content"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="2dp"
            android:text="@string/policy_second_alert_msg"/>
        <View
            android:background="@color/division_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:gravity="center"
            android:id="@+id/first_buttom"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/policy_second_alert_no"/>
        <View
            android:background="@color/division_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:gravity="center"
            android:id="@+id/second_buttom"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/policy_second_alert_yes"/>
    </LinearLayout>
</LinearLayout>
