<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/app_black"
            android:id="@+id/ftv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/laundry_activity_list_popupwindow_title"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:padding="14.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_close_black"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="17sp"
        android:textColor="@color/app_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="@string/laundry_activity_list_title"
        android:layout_marginStart="15dp"/>
    <com.haier.globalwasher.view.custom_view.mlistview.FixItemListView
        android:id="@+id/lv_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="5dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="17sp"
        android:textColor="@color/app_black"
        android:id="@+id/ftv_notify_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/laundry_activity_announcement"
        android:layout_marginStart="15dp"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="14sp"
        android:textColor="@color/app_black_6"
        android:id="@+id/ftv_notify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginStart="15dp"/>
</LinearLayout>
