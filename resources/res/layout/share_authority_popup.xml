<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cardview_background_whit_not_projection"
        android:layout_width="270dp"
        android:layout_height="wrap_content">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/app_black_6"
            android:gravity="center"
            android:id="@+id/ftv_title"
            android:paddingTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/request_share_window_title"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="13sp"
            android:textColor="@color/app_black_6"
            android:gravity="center"
            android:id="@+id/ftv_content"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp"
            android:paddingBottom="15dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:text="@string/request_share_window_content"/>
        <View
            android:background="@color/cancellation_account_prompt_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/app_black_6"
                android:gravity="center"
                android:id="@+id/ftv_deny"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/request_share_window_deny"
                android:layout_weight="1"/>
            <View
                android:background="@color/cancellation_account_prompt_line"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/app_zhexian_blue_relg"
                android:gravity="center"
                android:id="@+id/ftv_agreed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/request_share_window_agreed"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
