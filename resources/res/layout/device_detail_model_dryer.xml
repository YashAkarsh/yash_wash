<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/lly_margin_1"
            android:background="@drawable/first_laundry_item_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/defult_padding_16"
            android:layout_marginTop="@dimen/projection_list_top"
            android:layout_marginRight="@dimen/defult_padding_8"
            android:layout_marginBottom="@dimen/projection_list_bottom"
            android:minHeight="80dp"
            android:layout_weight="1"
            android:translationZ="2dp"
            android:elevation="3dp"
            android:outlineProvider="background">
            <ImageView
                android:id="@+id/iv_image_1"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="21dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="17dp"
                android:textColor="@color/app_black_6"
                android:id="@+id/tv_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/lly_margin_2"
            android:background="@drawable/first_laundry_item_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/defult_padding_8"
            android:layout_marginTop="@dimen/projection_list_top"
            android:layout_marginRight="@dimen/defult_padding_16"
            android:layout_marginBottom="@dimen/projection_list_bottom"
            android:minHeight="80dp"
            android:layout_weight="1"
            android:translationZ="2dp"
            android:elevation="3dp"
            android:outlineProvider="background">
            <ImageView
                android:id="@+id/iv_image_2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="21dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="17dp"
                android:textColor="@color/app_black_6"
                android:id="@+id/tv_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/device_run_model_item_subsidiary_content_text"
        android:orientation="vertical"
        android:id="@+id/tv_introduce"
        android:background="@drawable/item_subsidiary_entry"
        android:paddingLeft="16dp"
        android:paddingTop="13dp"
        android:paddingRight="20dp"
        android:paddingBottom="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/defult_padding_16"
        android:layout_marginTop="-13dp"
        android:layout_marginRight="@dimen/defult_padding_16"
        android:layout_marginBottom="12dp"
        android:drawableLeft="@drawable/icon_shuoming"
        android:drawablePadding="5dp"/>
</LinearLayout>
