<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/share_popupwindow_cancel"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/background_round_circle_12"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="6.5dp"
        android:layout_marginRight="7dp"
        android:layout_marginBottom="17dp"
        android:text="@string/share_window_cancel"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_round_circle_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:layout_above="@+id/tv_cancel">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_window_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/share_window_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ftv_whatsapp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:text="@string/share_window_whatsapp"
                android:drawableTop="@drawable/whatsapp"
                android:drawablePadding="15dp"
                android:layout_weight="1"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ftv_messenger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:text="@string/share_window_messenger"
                android:drawableTop="@drawable/messenger"
                android:drawablePadding="15dp"
                android:layout_weight="1"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ftv_instagram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:text="@string/share_window_instagram"
                android:drawableTop="@drawable/instagram"
                android:drawablePadding="15dp"
                android:layout_weight="1"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ftv_sms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:text="@string/share_window_sms"
                android:drawableTop="@drawable/sms"
                android:drawablePadding="15dp"
                android:layout_weight="1"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ftv_facebook"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:text="@string/share_window_facebook"
                android:drawableTop="@drawable/facebook"
                android:drawablePadding="15dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
