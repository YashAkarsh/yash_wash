<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lly_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13sp"
        android:textColor="@color/app_text"
        android:id="@+id/tv_title_not_frame"
        android:paddingLeft="29dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lly_margin"
            android:background="@drawable/cardview_background_huise_not_projection"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="@dimen/defult_padding_16"
            android:layout_marginTop="@dimen/projection_list_top"
            android:layout_marginRight="@dimen/defult_padding_16"
            android:layout_marginBottom="@dimen/projection_list_bottom"
            android:translationZ="2dp"
            android:elevation="2dp"
            android:outlineProvider="background">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="17sp"
                android:textColor="@color/app_black_6"
                android:gravity="center_vertical"
                android:id="@+id/tv_phone"
                android:background="@null"
                android:paddingLeft="15dp"
                android:focusable="true"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:lines="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="12sp"
        android:textColor="@color/updata_warning"
        android:id="@+id/tv_warning"
        android:paddingLeft="29dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"/>
</LinearLayout>
