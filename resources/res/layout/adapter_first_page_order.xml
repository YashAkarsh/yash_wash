<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/first_orderlist_inner_spacing"
    android:paddingRight="@dimen/first_orderlist_inner_spacing"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/iv_more"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/order_id_text"
            android:id="@+id/tv_orderid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/first_orderlist_content_inner_spacing"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="1px"
            android:layout_weight="1"/>
        <ImageView
            android:paddingLeft="20dp"
            android:paddingRight="@dimen/first_orderlist_content_inner_spacing"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_arrow_wode"/>
    </LinearLayout>
    <View
        android:background="@color/division_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/first_orderlist_content_inner_spacing"
        android:paddingRight="@dimen/first_orderlist_content_inner_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/order_item_order_statu"
            android:id="@+id/tv_order_statu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/drivice_type_name"
            android:id="@+id/tv_divice_type_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/drivice_type_name"
            android:gravity="center_vertical"
            android:id="@+id/tv_order_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:drawableLeft="@drawable/icon_money_dingdanliebiao"
            android:drawablePadding="3dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/drivice_type_name"
            android:gravity="center_vertical"
            android:id="@+id/tv_order_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:drawableLeft="@drawable/icon_money_dingdanliebiao"
            android:drawablePadding="3dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/rly_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/order_item_button_cancel"
                android:gravity="center"
                android:id="@+id/tv_cencle"
                android:background="@drawable/button_background_g40"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="@string/order_list_Btn_Cancel"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/order_item_right_button_text"
                android:gravity="center"
                android:id="@+id/tv_right_button"
                android:background="@drawable/button_background_g40_blue"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
