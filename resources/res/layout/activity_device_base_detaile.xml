<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/app_backgrade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/lv_run_model"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:layout_above="@+id/lly_view"
        android:layout_alignParentTop="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/button_view"
        android:background="@color/app_white"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/buttom_wash_button_height"
        android:layout_alignParentBottom="true">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_text"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="34dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_zhexian_blue_relg"
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="1px"
            android:layout_weight="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="16sp"
            android:textColor="@color/app_white"
            android:gravity="center"
            android:id="@+id/tv_wash_button"
            android:background="@drawable/button_background_g40_blue"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="@string/selective_washing_mode_btn_wash"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lly_view"
        android:background="@drawable/cardview_background_whit_not_projection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button_view"/>
</RelativeLayout>
