<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/app_backgrade"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/app_backgrade"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="52dp"
            android:src="@drawable/icon_haiwai_jinggao"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_color_defult"
            android:gravity="center"
            android:id="@+id/tv_phone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="16dp"
            android:text="@string/cancellation_account_msg_1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_color_defult"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12.5dp"
            android:layout_marginRight="16dp"
            android:text="@string/cancellation_account_msg_2"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/background_white_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12.5dp"
            android:layout_marginRight="16dp"
            android:paddingStart="30dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cancellation_account_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="@string/cancellation_account_msg_3"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/circle_3_radio"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cancellation_account_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:text="@string/cancellation_account_msg_4"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/circle_3_radio"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cancellation_account_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:text="@string/cancellation_account_msg_5"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/circle_3_radio"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cancellation_account_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14.5dp"
                android:text="@string/cancellation_account_msg_6"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/circle_3_radio"/>
            <View
                android:background="@color/cancellation_account_prompt_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="30dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/cancellation_account_prompt"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                android:text="@string/cancellation_account_msg_7"
                android:layout_marginEnd="30dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/app_white"
            android:gravity="center"
            android:id="@+id/tv_jump_next_page"
            android:background="@drawable/background_huise_button"
            android:layout_width="265dp"
            android:layout_height="50dp"
            android:layout_marginTop="33dp"
            android:text="@string/cancellation_account_btn_title"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp">
            <CheckBox
                android:gravity="center"
                android:id="@+id/cb_prompt_is_read"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/CustomCheckboxThemeSquare"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/app_black_6"
                android:gravity="center"
                android:id="@+id/tv_url_of_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancellation_account_protocol"
                android:lines="3"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
