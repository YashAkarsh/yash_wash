<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/lingin_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:text="@string/verify_the_machine_bigtitle"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="47dp"
            android:layout_marginTop="57dp"
            android:layout_marginRight="47dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/app_zhexian_blue_relg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/verify_the_machine_bigtitle_CODE"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <com.haier.globalwasher.view.custom_view.VerificationCodeEditText
                    android:textSize="30sp"
                    android:textColor="@color/lingin_text_color"
                    android:id="@+id/verification_code"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:inputType="number"
                    app:bottomLineHeight="2dp"
                    app:bottomLineNormalColor="@color/lingin_text_xiahuaxian"
                    app:bottomLineSelectedColor="@color/lingin_text_xiahuaxian"
                    app:figures="4"
                    app:selectedBackgroundColor="@color/app_white"
                    app:verCodeMargin="10dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <RelativeLayout
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/lingin_text_erre"
                        android:id="@+id/phone_pass_erre"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:lineSpacingMultiplier="1.2"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/app_text"
                        android:id="@+id/verification_code_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:lineSpacingMultiplier="1.2"/>
                </RelativeLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/app_white"
                    android:gravity="center"
                    android:id="@+id/verification_code_time"
                    android:background="@drawable/background_blue_button"
                    android:paddingLeft="10dp"
                    android:paddingTop="12dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_code_btn_resend"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
