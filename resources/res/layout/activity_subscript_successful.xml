<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/app_white"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="85dp"
        android:src="@drawable/icon_yuyuechenggong"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/order_apponintment_success"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/successful_appointment_scendtitle"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="15sp"
        android:textColor="@color/app_zhexian_blue_relg"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/successful_appointment_theretitle"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13sp"
        android:layout_gravity="left"
        android:id="@+id/tv_device_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:text="@string/successful_appointment_detailsone"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="13sp"
        android:layout_gravity="left"
        android:id="@+id/tv_device_number_tow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/successful_appointment_detailstwo"/>
    <com.haier.globalwasher.view.custom_view.FontTextView
        android:textSize="16dp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:id="@+id/tv_send_code"
        android:background="@drawable/background_blue_button"
        android:layout_width="265dp"
        android:layout_height="50dp"
        android:layout_marginTop="34dp"
        android:text="@string/successful_appointment_btn"/>
</LinearLayout>
