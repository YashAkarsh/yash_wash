<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/first_laundry_item_select"
        android:paddingLeft="14dp"
        android:paddingTop="18dp"
        android:paddingRight="14dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/defult_padding_16"
        android:layout_marginTop="5dp"
        android:layout_marginRight="@dimen/defult_padding_16"
        android:layout_marginBottom="@dimen/projection_list_bottom"
        android:translationZ="3dp"
        android:elevation="3dp"
        android:outlineProvider="background">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_youhuiquan"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="13sp"
            android:textColor="@color/app_text"
            android:id="@+id/tv_coupon_number"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textColor="@color/app_black_6"
            android:id="@+id/tv_coupon_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:lines="1"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="12sp"
            android:textColor="@color/app_text_coler"
            android:id="@+id/tv_coupon_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="1dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_arrow_wode"/>
    </LinearLayout>
</LinearLayout>
