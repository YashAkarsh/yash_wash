<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/capture_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/capture_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/capture_mask_top"
            android:background="@color/colorPrimaryDark"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentTop="true"/>
        <RelativeLayout
            android:id="@+id/capture_crop_view"
            android:layout_width="247dp"
            android:layout_height="350dp"
            android:layout_below="@+id/capture_mask_top"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/capture_scan_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_saomiaoxian"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/capture_mask_bottom"
            android:background="@color/colorPrimaryDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/capture_crop_view"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/capture_mask_left"
            android:background="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/capture_mask_bottom"
            android:layout_below="@+id/capture_mask_top"
            android:layout_toStartOf="@+id/capture_crop_view"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/capture_mask_right"
            android:background="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/capture_mask_bottom"
            android:layout_below="@+id/capture_mask_top"
            android:layout_toEndOf="@+id/capture_crop_view"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/capture_mask_lamp"
        android:background="@drawable/icon_shoudiantong_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
