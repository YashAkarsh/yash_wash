<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:background="@color/app_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/lingin_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:text="@string/find_newpwd_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="47dp"
            android:layout_marginTop="57dp"
            android:layout_marginRight="47dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/app_zhexian_blue_relg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/find_newpwd_hint"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <EditText
                    android:textSize="19sp"
                    android:textColor="@color/lingin_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/et_phone_pass"
                    android:background="@drawable/overall_situation_edit_unselected"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:cursorVisible="true"
                    android:layout_centerVertical="true"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/overall_situation_edit"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <ImageButton
                        android:id="@+id/login_password_eye"
                        android:background="@drawable/icon_eye_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp"/>
                    <ImageButton
                        android:id="@+id/login_password_dele"
                        android:background="@drawable/icon_cha_denglu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/lingin_text_erre"
                android:id="@+id/phone_pass_erre"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text=""/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/app_white"
        android:gravity="center"
        android:id="@+id/bt_login"
        android:background="@drawable/background_huise_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="100dp"
        android:text="@string/find_pwd_btn"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
