<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/laundry_id"
    android:paddingLeft="12dp"
    android:paddingTop="16dp"
    android:paddingRight="12dp"
    android:paddingBottom="16dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/app_black_6"
            android:id="@+id/laundry_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@+id/laundry_img"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/laundry_name">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="14sp"
                android:textColor="@color/app_white"
                android:gravity="center"
                android:id="@+id/laundry_open"
                android:background="@drawable/background_blue_button"
                android:paddingLeft="15dp"
                android:paddingTop="2dp"
                android:paddingRight="15dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/Nearby_laundry_atlas_btn_open"
                android:translationZ="3dp"
                android:elevation="3dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/app_zhexian_blue_relg"
                android:gravity="center_vertical"
                android:id="@+id/laundry_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"/>
            <View
                android:id="@+id/laundry_line"
                android:background="@color/division_line"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="14sp"
                android:textColor="@color/app_text"
                android:gravity="center_vertical"
                android:id="@+id/laundry_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/laundry_img"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_xiyidiantupian"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:background="@color/division_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ding_wei"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_dizhi_hui"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"/>
        <com.haier.globalwasher.view.custom_view.FontTextView
            android:textSize="14sp"
            android:textColor="@color/app_text"
            android:gravity="center_vertical"
            android:id="@+id/laundry_din"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/ding_wei"/>
    </RelativeLayout>
    <com.haier.globalwasher.view.custom_view.mlistview.MaxHeightListView
        android:id="@+id/lv_activity"
        android:background="#00000000"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="10dp"/>
</LinearLayout>
