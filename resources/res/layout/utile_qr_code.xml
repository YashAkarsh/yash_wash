<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lin_image"
        android:background="@drawable/share_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rly_view"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@+id/lin_image"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/show_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/app_black_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="27dp"
        android:text="@string/share_users_coupon"
        android:layout_below="@+id/rly_view"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
