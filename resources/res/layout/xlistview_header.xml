<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:background="@color/app_backgrade"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/xlistview_header_content"
        android:background="@color/app_backgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/xlistview_header_text"
            android:background="@color/app_backgrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textColor="@color/text_edit"
                android:id="@+id/xlistview_header_hint_textview"
                android:background="@color/app_backgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xlistview_header_hint_normal"/>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:id="@+id/xlistview_header_last_time"
                    android:background="@color/app_backgrade"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xlistview_header_last_time"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:id="@+id/xlistview_header_time"
                    android:background="@color/app_backgrade"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/xlistview_header_arrow"
            android:background="@color/app_backgrade"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-35dp"
            android:src="@drawable/xlistview_arrow"
            android:layout_alignLeft="@+id/xlistview_header_text"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/loadboyIv"
            android:background="@drawable/frame_loadboy"
            android:visibility="invisible"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@+id/xlistview_header_load"
            android:layout_centerVertical="true"/>
        <TextView
            android:textColor="@color/text_edit"
            android:id="@+id/xlistview_header_load"
            android:background="@color/app_backgrade"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xlistview_header_hint_loading"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
