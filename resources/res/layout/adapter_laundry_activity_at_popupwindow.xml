<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <com.haier.globalwasher.view.custom_view.viewgroup.RoundBGLinerLayout
        android:id="@+id/rbg_lly_coupon"
        android:padding="5dp"
        android:layout_width="115dp"
        android:layout_height="117dp"
        android:layout_marginStart="10dp"
        app:backgroundColor="@color/coupon_background"
        app:buttom_left_angle_direction="true"
        app:buttom_right_angle_direction="false"
        app:is_fill="true"
        app:radius="10dp"
        app:shadowColor="@color/coupon_background"
        app:top_left_angle_direction="true"
        app:top_right_angle_direction="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_activity_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/activity_type_name_discount"
                android:layout_alignParentTop="true"
                android:layout_marginStart="15dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/app_white"
                android:id="@+id/tv_activity_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="13sp"
                android:textColor="@color/app_white"
                android:id="@+id/tv_activity_single_introduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_below="@+id/tv_activity_content"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </com.haier.globalwasher.view.custom_view.viewgroup.RoundBGLinerLayout>
    <com.haier.globalwasher.view.custom_view.viewgroup.RoundBGLinerLayout
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_width="0dp"
        android:layout_height="117dp"
        android:layout_weight="1"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="10dp"
        app:backgroundColor="@color/app_white"
        app:buttom_left_angle_direction="false"
        app:is_fill="true"
        app:radius="10dp"
        app:shadowColor="@color/coupon_background"
        app:top_left_angle_direction="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/tv_activity_introduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/activity_item_intruduction_left_padding"
                android:layout_marginEnd="15dp"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="14sp"
                android:textColor="@color/app_text_coler"
                android:id="@+id/tv_activity_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/tv_activity_introduction"
                android:layout_marginStart="@dimen/activity_item_intruduction_left_padding"/>
            <com.haier.globalwasher.view.custom_view.FontTextView
                android:textSize="14sp"
                android:textColor="@color/app_white"
                android:gravity="center"
                android:layout_gravity="right"
                android:id="@+id/tv_activity_use"
                android:background="@drawable/button_background_g40_blue"
                android:paddingLeft="14dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="@string/laundry_activity_user_button"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/activity_item_intruduction_left_padding"
                android:layout_marginEnd="15dp"/>
        </RelativeLayout>
    </com.haier.globalwasher.view.custom_view.viewgroup.RoundBGLinerLayout>
</LinearLayout>
